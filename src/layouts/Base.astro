---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { settings } from '../lib/site';
// The two font files every page needs first; preloading them avoids a late swap.
import geistLatin from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
import geistMonoLatin from '@fontsource-variable/geist-mono/files/geist-mono-latin-wght-normal.woff2?url';

interface Props {
  title?: string;
  description?: string;
  /** Project accent; tints the page chrome when set. */
  accent?: string;
  image?: string;
  /** Alt text for the share image. */
  imageAlt?: string;
  type?: 'website' | 'article';
  /** ISO date for articles (logbook entries). */
  publishedAt?: string;
  /** Keep this page out of search results (the 404). */
  noindex?: boolean;
  /** Extra schema.org objects for this page, next to the site-wide Person. */
  jsonLd?: Record<string, unknown>[];
}

const {
  title,
  description = `${settings.name} — ${settings.role.toLowerCase()} in ${settings.location.split(',')[0]}. Case studies, a logbook and a museum of unfinished ideas.`,
  accent,
  image,
  imageAlt,
  type = 'website',
  publishedAt,
  noindex = false,
  jsonLd = [],
} = Astro.props;

const fullTitle = title ? `${title} — inside a head` : `inside a head — ${settings.name}`;
// No trailing slash (except the root), so the canonical, the sitemap and the RSS links all agree.
const path = Astro.url.pathname.length > 1 ? Astro.url.pathname.replace(/\/+$/, '') : '/';
const canonical = new URL(path, Astro.site);
const ogImage = new URL(image ?? '/og.png', Astro.site);
// Cloudflare Web Analytics: free, cookieless. Off until PUBLIC_CF_ANALYTICS_TOKEN is set in Vercel.
const analyticsToken = import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      // Apply the theme before first paint so there is no flash: the visitor's own choice if they made one,
      // otherwise night after 20:00 and before 06:00 in Timișoara, when the coffee shop is open late.
      (() => {
        const root = document.documentElement;
        let t = null;
        try { t = localStorage.getItem('theme'); } catch {}
        if (t === 'light' || t === 'dark') { root.dataset.theme = t; return; }
        const hour = Number(new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/Bucharest', hour: 'numeric', hourCycle: 'h23' }).format(new Date()));
        if (hour >= 20 || hour < 6) { root.dataset.theme = 'dark'; root.dataset.night = ''; }
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="preload" href={geistLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={geistMonoLatin} as="font" type="font/woff2" crossorigin />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title="inside a head — logbook" href="/logbook/rss.xml" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f4f3ef" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#14110d" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:site_name" content="inside a head" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={imageAlt ?? fullTitle} />
    {publishedAt && <meta property="article:published_time" content={publishedAt} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify([
      {
        '@context': 'https://schema.org',
        '@type': 'Person',
        name: settings.name,
        jobTitle: settings.role,
        email: `mailto:${settings.email}`,
        address: { '@type': 'PostalAddress', addressLocality: settings.location },
        url: Astro.site,
        sameAs: [settings.linkedin, settings.github],
      },
      ...jsonLd.map((o) => ({ '@context': 'https://schema.org', ...o })),
    ])} />
  </head>
  <body style={accent ? `--accent: ${accent}` : undefined}>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    {analyticsToken && (
      <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: analyticsToken })}></script>
    )}
  </body>
</html>

