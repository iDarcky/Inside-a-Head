---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { settings } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  /** Project accent; tints the page chrome when set. */
  accent?: string;
  image?: string;
  type?: 'website' | 'article';
}

const {
  title,
  description = `${settings.name} — ${settings.role.toLowerCase()} in ${settings.location.split(',')[0]}. Case studies, a logbook and a museum of unfinished ideas.`,
  accent,
  image,
  type = 'website',
} = Astro.props;

const fullTitle = title ? `${title} — Inside a Head` : `Inside a Head — ${settings.name}, ${settings.role}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ? new URL(image, Astro.site) : undefined;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f4f3ef" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0d0d0c" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: settings.name,
      jobTitle: settings.role,
      url: Astro.site,
      sameAs: [settings.linkedin, settings.github],
    })} />
  </head>
  <body style={accent ? `--accent: ${accent}` : undefined}>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  @view-transition { navigation: auto; }
  ::view-transition-old(root),
  ::view-transition-new(root) {
    animation-duration: 180ms;
    animation-timing-function: var(--ease-out);
  }
</style>
