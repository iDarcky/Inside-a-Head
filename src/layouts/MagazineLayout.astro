---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import SEO from '../components/SEO.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  backgroundColor?: string;
  description?: string;
  image?: string | null;
  type?: 'website' | 'article' | 'profile';
  publishedAt?: string;
  noindex?: boolean;
  jsonLd?: Record<string, any> | Record<string, any>[];
}

const { title, backgroundColor, description, image, type, publishedAt, noindex, jsonLd } = Astro.props;
const fullTitle = `${title} | Inside a Head`;
---

<!DOCTYPE html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <SEO title={fullTitle} description={description} image={image} type={type} publishedAt={publishedAt} noindex={noindex} jsonLd={jsonLd} />
    
    <!-- Lucide Icons -->
    <script is:inline src="https://unpkg.com/lucide@0.460.0"></script>
    
    <!-- GSAP & ScrollTrigger -->
    <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
    <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>
    <ClientRouter />
  </head>
  <body id="top" class="magazine-layout page-wrapper" data-project-bg={backgroundColor} style={backgroundColor ? `background-color: ${backgroundColor};` : ''}>
    <a href="#main-content" class="skip-link">Skip to content</a>
    <div class="custom-cursor" transition:persist aria-hidden="true"></div>
    
    <header class="project-header">
      <div class="header-inner">
        <a href="/" class="project-logo" data-hover>
          <span>INSIDE A HEAD</span>
          <span class="anchor-sub">STUDIO</span>
        </a>
        <nav class="nav-links">
          <a href="/" class="nav-link" data-hover>Studio</a>
          <a href="/logbook" class="nav-link" data-hover>Logbook</a>
          <a href="/resume" class="nav-link" data-hover>Resume</a>
        </nav>
        <!-- Mobile Hamburger Button -->
        <button class="hamburger-btn" aria-label="Toggle menu" aria-expanded="false" aria-controls="mobile-menu">
          <div class="hamburger-box">
            <div class="hamburger-line"></div>
            <div class="hamburger-line"></div>
            <div class="hamburger-line"></div>
          </div>
        </button>
      </div>
    </header>

    <!-- Full-Screen Hamburger Menu Overlay -->
    <div class="mobile-menu-overlay" id="mobile-menu">
      <nav class="mobile-nav-links">
        <a href="/" class="mobile-nav-link">Studio</a>
        <a href="/logbook" class="mobile-nav-link">Logbook</a>
        <a href="/resume" class="mobile-nav-link">Resume</a>
      </nav>
      <div class="mobile-menu-footer">
        <div class="mobile-socials">
          <a href="https://github.com/iDarcky" target="_blank" rel="noreferrer">GITHUB</a>
          <a href="https://www.linkedin.com/in/danielnmaghis/" target="_blank" rel="noreferrer">LINKEDIN</a>
          <a href="mailto:maghisdaniel@gmail.com">EMAIL</a>
        </div>
      </div>
    </div>

    <!-- The actual content injected here -->
    <div id="main-content" tabindex="-1">
      <slot />
    </div>
    
    <Footer />

    <script is:inline src="/project.js"></script>
  </body>
</html>
