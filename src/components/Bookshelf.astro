---
// The Museum of my Mess as a bookshelf, designed as one series: every spine shares a catalogue number, the title,
// the project's own emblem, the year and the studio's mark, bound in a deep version of the project's colour.
// Pick a spine to read about it. An idea that hasn't started yet leans on its neighbour: the one thing out of place.
import Arrow from './Arrow.astro';
import Mark from './Mark.astro';

export interface Book {
  id: string;
  title: string;
  year?: string | null;
  /** The project's own colour; the spine is bound in a deeper version of it. */
  color: string;
  meta: string;
  text: string;
  href?: string;
  linkLabel?: string;
  emblem?: Emblem;
  lean?: boolean;
}

export type Emblem = 'pixels' | 'staff' | 'sun' | 'road' | 'track';

// Small marks drawn on a 40-unit square, one per project, in the spine's lettering colour.
const emblems: Record<Emblem, string> = {
  // The Retro Circuit: a pixel staircase.
  pixels: '<path fill="currentColor" d="M2 38V30h9v-9h9v-9h9V3h9v35Z"/>',
  // Setlists.md: a stave with one note.
  staff:
    '<g stroke="currentColor" stroke-width="1.5"><path d="M2 9h36M2 15h36M2 21h36M2 27h36M2 33h36"/></g>' +
    '<ellipse cx="22" cy="27" rx="5.2" ry="3.8" transform="rotate(-20 22 27)" fill="currentColor"/>' +
    '<path d="M26.6 25.6V5" stroke="currentColor" stroke-width="1.8"/>',
  // Meridian: the sun on the horizon.
  sun: '<path fill="currentColor" d="M7 29a13 13 0 0 1 26 0Z"/><path d="M2 33h36" stroke="currentColor" stroke-width="2.5"/>',
  // Ridely: a road with its lane markings.
  road:
    '<g stroke="currentColor" fill="none"><path d="M6 1v38M34 1v38" stroke-width="2"/>' +
    '<path d="M20 2v8M20 16v8M20 30v8" stroke-width="3.5"/></g>',
  // Redline Running: a running track.
  track:
    '<g stroke="currentColor" stroke-width="2.5" fill="none"><rect x="2" y="9" width="36" height="22" rx="11"/>' +
    '<rect x="9" y="15.5" width="22" height="9" rx="4.5"/></g>',
};

/** Deepens a colour 25% toward warm black, like dyed bookcloth. Cream lettering reads at 5.7:1 or better. */
function cloth(hex: string): string {
  const black = [0x1a, 0x16, 0x12];
  const rgb = [1, 3, 5].map((i) => parseInt(hex.slice(i, i + 2), 16));
  return `rgb(${rgb.map((c, i) => Math.round(c * 0.75 + black[i] * 0.25)).join(' ')})`;
}

interface Props { books: Book[] }
const { books } = Astro.props;
const heights = [100, 90, 95, 86, 92];
// Books are not all the same thickness.
const widths = [1, 0.86, 0.94, 0.8, 0.9];
---
<div class="bookshelf" data-bookshelf>
  <ul class="shelf" role="list" aria-label="Books on the shelf">
    {books.map((b, i) => (
      <li class:list={['book', { lean: b.lean }]} style={`--h: ${heights[i % heights.length]}%; --w: ${widths[i % widths.length]}; --cover: ${cloth(b.color)}`}>
        <button type="button" aria-controls={`book-${b.id}`} aria-expanded={i === 0 ? 'true' : 'false'} data-book={b.id}>
          <span class="spine-no mono">{String(i + 1).padStart(2, '0')}</span>
          <span class="spine-title">{b.title}</span>
          <span class="spine-foot">
            {b.emblem && <svg class="emblem" viewBox="0 0 40 40" aria-hidden="true" set:html={emblems[b.emblem]} />}
            {b.year && <span class="spine-year mono">{b.year}</span>}
            <Mark size={14} class="spine-mark" />
          </span>
        </button>
      </li>
    ))}
  </ul>
  <div class="notes">
    {books.map((b, i) => (
      <article class="note" id={`book-${b.id}`} hidden={i !== 0} style={`--cover: ${cloth(b.color)}`}>
        <p class="mono meta">{b.meta}</p>
        <h3>{b.title}</h3>
        <p class="text">{b.text}</p>
        {b.href && (
          <a class="more" href={b.href}>{b.linkLabel ?? 'Read more'} <Arrow dir="right" /></a>
        )}
      </article>
    ))}
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-bookshelf]').forEach((shelf) => {
    const buttons = [...shelf.querySelectorAll<HTMLButtonElement>('[data-book]')];
    buttons.forEach((b) =>
      b.addEventListener('click', () => {
        buttons.forEach((o) => {
          const open = o === b;
          o.setAttribute('aria-expanded', String(open));
          shelf.querySelector<HTMLElement>(`#book-${o.dataset.book}`)!.hidden = !open;
        });
      }),
    );
  });
</script>

<style>
  .bookshelf { display: grid; gap: var(--s-12); }
  @media (min-width: 960px) {
    .bookshelf { grid-template-columns: 7fr 5fr; align-items: end; gap: var(--gutter); }
  }

  .shelf {
    list-style: none;
    display: flex;
    align-items: flex-end;
    gap: 3px;
    height: clamp(420px, 34vw, 480px);
    padding: var(--s-6) var(--s-2) 0; /* headroom for a book pulled off the shelf */
    border-bottom: 6px solid var(--ink);
    overflow-x: auto;
    scrollbar-width: none;
  }
  .book { height: var(--h); flex: none; display: flex; }
  .book button {
    all: unset;
    box-sizing: border-box;
    cursor: pointer;
    height: 100%;
    width: calc(clamp(58px, 7.2vw, 108px) * var(--w));
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-block: 14px 16px;
    background: var(--cover);
    color: #f2ebdd;
    /* A crisp hinge on each side, so neighbouring books read as separate volumes. */
    box-shadow: inset -2px 0 0 rgb(0 0 0 / 0.22), inset 2px 0 0 rgb(255 255 255 / 0.06);
    transition: transform 180ms var(--ease-out);
  }
  .book button:focus-visible { outline: 2px solid var(--signal); outline-offset: 3px; }
  .spine-no {
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    padding-bottom: 12px;
    margin-bottom: 18px;
    border-bottom: 1px solid rgb(242 235 221 / 0.4);
    width: 56%;
    text-align: center;
  }
  .spine-title {
    writing-mode: vertical-rl;
    font-weight: 600;
    font-size: clamp(0.6875rem, 0.5rem + 0.5vw, 0.9375rem);
    line-height: 1.1;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .spine-foot {
    margin-top: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    width: 100%;
    padding-top: 16px;
  }
  .emblem { width: min(46%, 36px); height: auto; }
  .spine-year { font-size: 0.6875rem; letter-spacing: 0.08em; opacity: 0.8; }
  .book :global(.spine-mark) { opacity: 0.9; }
  @media (max-width: 599px) {
    .shelf { height: 400px; }
    .spine-no { padding-bottom: 8px; margin-bottom: 12px; }
    .spine-title { letter-spacing: 0.1em; }
    .spine-foot { gap: 8px; padding-top: 12px; }
  }

  /* Pulling a book off the shelf: it rises a little on hover and stays up while open. */
  @media (hover: hover) {
    .book button:hover { transform: translateY(-8px); }
  }
  .book button[aria-expanded='true'] { transform: translateY(-14px); }

  /* The one thing out of place: an idea that hasn't started yet, leaning on its neighbour. */
  .lean { margin-left: 40px; }
  .lean button { transform: rotate(-7deg); transform-origin: bottom left; }
  .lean button[aria-expanded='true'] { transform: rotate(-7deg) translateY(-14px); }
  @media (hover: hover) {
    .lean button:hover { transform: rotate(-3deg) translateY(-6px); }
  }

  .notes { min-height: 12rem; }
  .note { display: grid; gap: var(--s-3); max-width: 48ch; }
  .note[hidden] { display: none; }
  .note::before {
    content: '';
    display: block;
    width: 48px;
    height: 8px;
    background: var(--cover);
    margin-bottom: var(--s-2);
  }
  .meta { color: var(--ink-2); }
  .note h3 { font-size: var(--t-h3); letter-spacing: -0.03em; line-height: 1.1; }
  .note .text { color: var(--ink-2); font-size: 1.0625rem; }
  .more {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    justify-self: start;
    font-size: var(--t-small);
    font-weight: 500;
  }

  @media (prefers-reduced-motion: reduce) {
    .book button { transition: none; }
  }
</style>
