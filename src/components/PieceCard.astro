---
// One piece of the Museum of my Mess: the image on a panel of the project's colour, then the facts.
// Used by the homepage carousel and, in the wide layout, as the "next" card at the end of a case study,
// so both read as the same object.
import { Picture } from 'astro:assets';
import AppLogo from './AppLogo.astro';
import Arrow from './Arrow.astro';
import type { Piece } from '../lib/museum';

interface Props {
  piece: Piece;
  /** Load the image straight away (cards visible on arrival). */
  eager?: boolean;
  /** 'stack' puts the text under the image; 'wide' puts it beside the image from tablet width up. */
  layout?: 'stack' | 'wide';
  /** Overrides the kicker, e.g. "02 / 05". */
  kicker?: string;
}
const { piece: p, eager = false, layout = 'stack', kicker } = Astro.props;
const Tag = p.href ? 'a' : 'div';
const sizes = layout === 'wide' ? '(min-width: 720px) 55vw, 92vw' : '(min-width: 960px) 40vw, 84vw';
---
<Tag class:list={['card', p.kind, layout]} href={p.href} style={`--accent: ${p.color}`}>
  <div class:list={['thumb', p.imageShape ?? 'screen']}>
    {p.image && (
      <Picture
        src={p.image}
        alt={p.imageAlt ?? ''}
        formats={['webp']}
        widths={p.imageShape === 'phone' ? [320, 480, 640] : [480, 800, 1200]}
        sizes={sizes}
        loading={eager ? 'eager' : 'lazy'}
      />
    )}
  </div>
  <div class="info">
    <p class="kicker mono">
      <span>{kicker ?? <>{String(p.number).padStart(2, '0')}{p.kind === 'idea' && ' · Idea'}</>}</span>
      {p.logo && <AppLogo logo={p.logo} class="logo" />}
    </p>
    <h3>{p.title}</h3>
    <p class="summary">{p.text}</p>
    <p class="facts mono">{[p.year, p.platform, p.status].filter(Boolean).join(' · ')}</p>
    {p.href && <span class="more">{p.linkLabel} <Arrow dir="right" /></span>}
  </div>
</Tag>

<style>
  .card {
    display: grid;
    gap: var(--s-6);
    height: 100%;
    text-decoration: none;
    color: inherit;
  }
  .card:focus-visible { outline: 2px solid var(--signal); outline-offset: 4px; }
  @media (min-width: 720px) {
    .card.wide { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: var(--gutter); align-items: center; }
  }

  /* The image on a panel of the project's colour. */
  .thumb {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--accent);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .thumb :global(picture) { display: contents; }
  .thumb :global(img) { display: block; transition: transform 320ms var(--ease-out); }
  /* One framing rule for every piece: the whole image, centred, with the same inset on all sides. */
  .thumb :global(img) {
    width: auto;
    height: auto;
    max-width: 84%;
    max-height: 84%;
    object-fit: contain;
    box-shadow: 0 12px 28px -12px rgb(0 0 0 / 0.45);
  }

  .info { display: grid; gap: var(--s-3); align-content: start; }
  .kicker { display: flex; align-items: center; justify-content: space-between; color: var(--ink-2); font-size: 0.8125rem; }
  .kicker :global(.logo) { width: 24px; color: var(--accent); }
  :global(:root[data-theme='dark']) .kicker :global(.logo) { color: color-mix(in oklab, var(--accent) 55%, var(--ink)); }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .kicker :global(.logo) { color: color-mix(in oklab, var(--accent) 55%, var(--ink)); }
  }
  h3 { font-size: clamp(1.75rem, 1.1rem + 2vw, 3rem); font-weight: 650; letter-spacing: -0.04em; line-height: 0.98; text-wrap: balance; }
  .wide h3 { font-size: var(--t-h2); line-height: 0.95; }
  .summary { color: var(--ink-2); font-size: 1.0625rem; line-height: 1.4; max-width: 44ch; }
  .facts { color: var(--ink-2); font-size: 0.8125rem; }
  .more { display: inline-flex; align-items: center; gap: var(--s-2); justify-self: start; font-size: var(--t-small); font-weight: 500; border-bottom: 1.5px solid var(--accent); padding-bottom: 2px; margin-top: var(--s-1); }
  .more :global(svg) { transition: transform 200ms var(--ease-out); }

  @media (hover: hover) {
    a.card:hover .thumb :global(img) { transform: translateY(-6px) scale(1.02); }
    a.card:hover .more :global(svg) { transform: translateX(3px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .thumb :global(img) { transition: none; }
  }
</style>
