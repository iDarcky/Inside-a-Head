---
// The Museum of my Mess as the letterboard behind the counter of a coffee shop that's open past midnight.
// Projects are on the menu; ideas are chalked in under "coming soon", slightly crooked: the one thing out of
// place. Pick an item to read about it.
import AppLogo from './AppLogo.astro';
import Arrow from './Arrow.astro';
import type { Piece } from '../lib/museum';

interface Props { pieces: Piece[] }
const { pieces } = Astro.props;
const served = pieces.filter((p) => p.kind === 'project');
const soon = pieces.filter((p) => p.kind === 'idea');
const isLive = (p: Piece) => /live/i.test(p.status ?? '');
// The short "price" column: live, or the version number.
const tag = (p: Piece) => (isLive(p) ? 'LIVE' : (p.status ?? '').split(',')[0].trim().toUpperCase());
---
<div class="menu" data-menu>
  <div class="board">
    <p class="board-head">inside a head · open past midnight</p>
    <ul class="items" role="list">
      {served.map((p, i) => (
        <li>
          <button type="button" class="item" aria-expanded={i === 0 ? 'true' : 'false'} aria-controls={`menu-${p.id}`} data-item={p.id}>
            {p.logo && <AppLogo logo={p.logo} class="item-logo" />}
            <span class="name">{p.title}</span>
            <span class="leader" aria-hidden="true"></span>
            <span class="where">{(p.platform ?? '').split(/[ ,(]/)[0]} · {p.year}</span>
            <span class="tag">{tag(p)}</span>
          </button>
        </li>
      ))}
    </ul>
    {soon.length > 0 && (
      <div class="soon">
        <p class="soon-head">Coming soon</p>
        {soon.map((p) => (
          <button type="button" class="item chalk" aria-expanded="false" aria-controls={`menu-${p.id}`} data-item={p.id}>
            <span class="name">{p.title}</span>
          </button>
        ))}
      </div>
    )}
  </div>
  <div class="notes">
    {pieces.map((p, i) => (
      <article class="note" id={`menu-${p.id}`} hidden={i !== 0} style={`--accent: ${p.color}`}>
        <p class="mono meta">{[p.platform, p.year, p.status].filter(Boolean).join(' · ')}</p>
        <h3>{p.title}</h3>
        <p class="text">{p.text}</p>
        {p.href && <a class="more" href={p.href}>{p.linkLabel} <Arrow dir="right" /></a>}
      </article>
    ))}
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-menu]').forEach((root) => {
    const items = [...root.querySelectorAll<HTMLButtonElement>('[data-item]')];
    items.forEach((b) =>
      b.addEventListener('click', () => {
        items.forEach((o) => {
          const open = o === b;
          o.setAttribute('aria-expanded', String(open));
          root.querySelector<HTMLElement>(`#menu-${o.dataset.item}`)!.hidden = !open;
        });
      }),
    );
  });
</script>

<style>
  .menu { display: grid; gap: var(--s-12); }
  .menu > * { min-width: 0; }
  @media (min-width: 960px) {
    .menu { grid-template-columns: 7fr 5fr; align-items: center; gap: var(--gutter); }
  }

  /* A felt letterboard: black felt with grooves, in a thin frame. Fixed colours, it's a physical object. */
  .board {
    --felt: #121110;
    --letter: #f4f1ea;
    position: relative;
    padding: var(--s-8) clamp(16px, 4vw, 48px) var(--s-12);
    background:
      repeating-linear-gradient(180deg, rgb(255 255 255 / 0.035) 0 1px, transparent 1px 6px),
      var(--felt);
    color: var(--letter);
    border: 10px solid #2b2722;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.06), 0 20px 30px -18px rgb(0 0 0 / 0.55);
  }
  .board-head {
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-align: center;
    opacity: 0.7;
    margin-bottom: var(--s-8);
  }
  .items { list-style: none; display: grid; gap: var(--s-2); }
  .item {
    all: unset;
    box-sizing: border-box;
    cursor: pointer;
    width: 100%;
    display: grid;
    grid-template-columns: auto auto 1fr auto auto;
    align-items: baseline;
    column-gap: var(--s-3);
    padding: var(--s-2) var(--s-2);
    font-family: var(--mono);
    font-size: clamp(0.875rem, 0.7rem + 0.5vw, 1.125rem);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: background-color 160ms ease;
  }
  .item:focus-visible { outline: 2px solid var(--letter); outline-offset: 2px; }
  .item:hover, .item[aria-expanded='true'] { background: rgb(255 255 255 / 0.06); }
  .item :global(.item-logo) { width: 18px; align-self: center; }
  .name { font-weight: 600; white-space: nowrap; }
  .leader { border-bottom: 2px dotted rgb(244 241 234 / 0.4); transform: translateY(-4px); min-width: 1rem; }
  .where { opacity: 0.75; font-size: 0.85em; white-space: nowrap; }
  .tag { font-weight: 600; min-width: 4.5ch; text-align: right; }
  .item[aria-expanded='true'] .name::before { content: '→ '; }

  /* Coming soon: chalked in by hand, slightly crooked. */
  .soon {
    margin-top: var(--s-8);
    padding-top: var(--s-6);
    border-top: 2px dotted rgb(244 241 234 / 0.3);
    transform: rotate(-2deg);
    transform-origin: left center;
  }
  .soon-head { font-family: var(--mono); font-size: 0.75rem; letter-spacing: 0.18em; text-transform: uppercase; opacity: 0.6; margin-bottom: var(--s-2); }
  .chalk { grid-template-columns: auto; color: #ffb4b4; font-style: italic; }

  @media (max-width: 599px) {
    .item { grid-template-columns: auto 1fr auto; row-gap: 2px; }
    .leader { display: none; }
    .where { grid-column: 2 / -1; grid-row: 2; }
    .name { white-space: normal; }
  }

  .note { display: grid; gap: var(--s-3); max-width: 48ch; }
  .note[hidden] { display: none; }
  .note::before { content: ''; display: block; width: 48px; height: 8px; background: var(--accent); margin-bottom: var(--s-2); }
  .meta { color: var(--ink-2); }
  .note h3 { font-size: var(--t-h3); letter-spacing: -0.03em; line-height: 1.1; }
  .note .text { color: var(--ink-2); font-size: 1.0625rem; }
  .more { display: inline-flex; align-items: center; gap: var(--s-2); justify-self: start; font-size: var(--t-small); font-weight: 500; }
</style>
