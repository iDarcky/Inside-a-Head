---
// The Museum of my Mess as a gallery wall. Each project hangs framed, salon-style, with a museum placard
// beside it; a soft spotlight falls on every frame. The idea that hasn't started yet hangs crooked: the one
// thing out of place.
import { Picture } from 'astro:assets';
import Arrow from './Arrow.astro';
import type { Piece } from '../lib/museum';

interface Props { pieces: Piece[] }
const { pieces } = Astro.props;
// Where each piece hangs on the 12-column wall (desktop), in order.
const hang = [
  'grid-column: 1 / span 6; --drop: 0px',
  'grid-column: 8 / span 5; --drop: 72px',
  'grid-column: 1 / span 3; --drop: 24px',
  'grid-column: 5 / span 3; --drop: 0px',
  'grid-column: 9 / span 3; --drop: 48px',
];
---
<div class="wall">
  {pieces.map((p, i) => {
    const frame = p.image && (
      <Picture
        src={p.image}
        alt={p.imageAlt ?? ''}
        formats={['webp']}
        widths={p.imageShape === 'phone' ? [320, 480, 720] : [640, 960, 1400]}
        sizes={p.imageShape === 'phone' ? '(min-width: 720px) 22vw, 70vw' : '(min-width: 720px) 45vw, 90vw'}
        loading={i < 2 ? 'eager' : 'lazy'}
      />
    );
    return (
      <figure class:list={['piece', p.imageShape ?? 'screen', { crooked: p.kind === 'idea' }]} style={`${hang[i % hang.length]}; --accent: ${p.color}`}>
        {p.href ? (
          <a class="frame" href={p.href} aria-label={`${p.title}: ${p.linkLabel}`}><span class="mat">{frame}</span></a>
        ) : (
          <div class="frame"><span class="mat">{frame}</span></div>
        )}
        <figcaption class="placard">
          <p class="placard-title">{p.title}</p>
          <p class="mono">{[p.year, p.platform].filter(Boolean).join(' · ')}</p>
          {p.stack && <p class="medium">{p.stack}</p>}
          <p class="desc">{p.text}</p>
          <p class="mono status">{p.status}</p>
          {p.href && <a class="more" href={p.href}>{p.linkLabel} <Arrow dir="right" /></a>}
        </figcaption>
      </figure>
    );
  })}
</div>

<style>
  .wall {
    overflow-x: clip; /* the gallery lights spill a little past the frames */
    overflow-y: visible;
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    column-gap: var(--gutter);
    row-gap: var(--s-16);
    align-items: start;
  }
  .piece {
    grid-column: 1 / -1;
    position: relative;
    display: grid;
    gap: var(--s-4);
    margin-top: var(--drop, 0px);
  }
  @media (max-width: 719px) {
    .piece { grid-column: 1 / -1 !important; margin-top: 0; }
    .piece.phone .frame { width: 72%; }
  }

  /* Gallery light: a soft pool of light above each frame. Warmer at night. */
  .piece::before {
    content: '';
    position: absolute;
    z-index: -1;
    left: -10%;
    right: -10%;
    top: -60px;
    height: 70%;
    background: radial-gradient(ellipse 60% 70% at 50% 0%, rgb(255 255 255 / 0.65), transparent 70%);
    pointer-events: none;
  }
  :global(:root[data-theme='dark']) .piece::before {
    background: radial-gradient(ellipse 60% 70% at 50% 0%, rgb(224 164 88 / 0.14), transparent 70%);
  }

  /* The frame: a thin dark moulding, a cream mat, and a soft shadow on the wall. */
  .frame {
    display: block;
    padding: 9px;
    background: #23201b;
    box-shadow: 0 1px 0 rgb(255 255 255 / 0.08) inset, 0 18px 26px -14px rgb(0 0 0 / 0.5), 0 2px 4px rgb(0 0 0 / 0.2);
    transition: transform 200ms var(--ease-out);
  }
  a.frame:hover { transform: translateY(-3px); }
  a.frame:focus-visible { outline: 2px solid var(--signal); outline-offset: 4px; }
  .mat {
    display: block;
    padding: 9%;
    background: #f7f4ec;
    box-shadow: inset 0 2px 6px rgb(0 0 0 / 0.18);
  }
  .phone .mat { padding: 12%; }
  .mat :global(picture) { display: contents; }
  .mat :global(img) { display: block; width: 100%; height: auto; box-shadow: 0 0 0 1px rgb(0 0 0 / 0.08); }

  /* The one thing out of place. */
  .crooked .frame { transform: rotate(-3.5deg); }
  .crooked .frame:hover { transform: rotate(-2deg); }

  /* The placard: a small card on the wall, like a museum label. */
  .placard {
    justify-self: start;
    display: grid;
    gap: 4px;
    max-width: 34ch;
    padding: var(--s-3) var(--s-4) var(--s-4);
    background: #fdfcf8;
    color: #1d1b17;
    border-left: 3px solid var(--accent);
    box-shadow: 0 6px 12px -8px rgb(0 0 0 / 0.35);
    font-size: var(--t-small);
  }
  .placard-title { font-weight: 650; font-size: 1rem; letter-spacing: -0.01em; }
  .placard .mono { color: #6b665c; }
  .medium { font-style: italic; color: #4a463e; }
  .desc { margin-top: var(--s-2); color: #33302a; line-height: 1.45; }
  .status { margin-top: var(--s-1); }
  .more { display: inline-flex; align-items: center; gap: var(--s-1); justify-self: start; margin-top: var(--s-2); font-weight: 500; color: #1d1b17; text-decoration-color: var(--accent); }
</style>
