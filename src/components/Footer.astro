---
import { settings } from '../lib/site';
import Arrow from './Arrow.astro';

const year = new Date().getFullYear();
---
<footer class="site-footer wrap" id="contact">
  <div class="cta grid">
    <h2>Got an idea, or just want to say hi?</h2>
    <ul class="actions">
      <li><a href={`mailto:${settings.email}`}>Email</a></li>
      <li><a href={settings.linkedin} rel="me noreferrer">LinkedIn <Arrow /></a></li>
      <li><a href={settings.github} rel="me noreferrer">GitHub <Arrow /></a></li>
      <li><a href="/resume">Resume</a></li>
    </ul>
  </div>
  <div class="base grid mono">
    <span>© {year} {settings.name}</span>
    <span class="clock">
      <span>{settings.location.split(',')[0]}</span>
      <time data-clock={settings.timeZone} aria-live="off"></time>
    </span>
    <span class="links">
      <a href="/logbook/rss.xml">RSS</a>
    </span>
  </div>
</footer>

<script>
  // Local time in the studio's time zone. Rendered on the client only, so it is never stale.
  const els = document.querySelectorAll<HTMLTimeElement>('time[data-clock]');
  const tick = () => {
    const now = new Date();
    els.forEach((el) => {
      const fmt = new Intl.DateTimeFormat('en-GB', { timeZone: el.dataset.clock, hour: '2-digit', minute: '2-digit' });
      el.textContent = fmt.format(now);
      el.dateTime = now.toISOString();
    });
  };
  tick();
  setInterval(tick, 15_000);
</script>

<style>
  .site-footer {
    padding-bottom: max(var(--s-8), env(safe-area-inset-bottom));
  }
  .cta {
    border-top: 2px solid var(--rule);
    padding-block: var(--s-6) var(--s-24);
    row-gap: var(--s-8);
  }
  h2 {
    grid-column: 1 / -1;
    font-size: var(--t-h2);
    max-width: 14ch;
  }
  .actions {
    grid-column: 1 / -1;
    list-style: none;
    display: grid;
    align-self: end;
    border-top: 1px solid var(--hairline);
  }
  .actions li { border-bottom: 1px solid var(--hairline); }
  .actions a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 48px;
    font-size: var(--t-lead);
    font-weight: 500;
    letter-spacing: -0.015em;
    text-decoration: none;
  }
  .actions a:hover { text-decoration: underline; text-decoration-thickness: 2px; }
  @media (min-width: 720px) {
    h2 { grid-column: 1 / span 7; }
    .actions { grid-column: 9 / -1; }
  }
  .base {
    border-top: 1px solid var(--hairline);
    padding-top: var(--s-4);
    row-gap: var(--s-2);
    color: var(--ink-2);
  }
  .base > * { grid-column: 1 / -1; }
  .clock { display: inline-flex; gap: var(--s-2); }
  .links { display: flex; gap: var(--s-4); }
  .links a { text-decoration: none; }
  .links a:hover { color: var(--ink); text-decoration: underline; }
  @media (min-width: 720px) {
    .base > :nth-child(1) { grid-column: 1 / span 4; }
    .base > :nth-child(2) { grid-column: 5 / span 4; }
    .base > :nth-child(3) { grid-column: 9 / -1; justify-content: flex-end; }
  }
</style>
