---
// The Museum of my Mess as a Swiss index: one row per piece on the 12-column grid, separated by hairlines.
// Catalogue number, title and summary, the facts in mono with the app's own logo, and its image on a panel of
// the project's colour. An idea that hasn't started yet closes the list with its image hung slightly crooked:
// the one thing out of place.
import { Picture } from 'astro:assets';
import AppLogo from './AppLogo.astro';
import Arrow from './Arrow.astro';
import type { Piece } from '../lib/museum';

interface Props { pieces: Piece[] }
const { pieces } = Astro.props;
---
<ol class="index" role="list">
  {pieces.map((p, i) => {
    const Tag = p.href ? 'a' : 'div';
    return (
      <li class:list={['entry', p.kind]} style={`--accent: ${p.color}`}>
        <Tag class="row" href={p.href}>
          <span class="no mono" aria-hidden="true">{String(p.number).padStart(2, '0')}</span>
          <div class="head">
            <h3>{p.title}</h3>
            <p class="summary">{p.text}</p>
          </div>
          <dl class="facts mono">
            {p.logo && <AppLogo logo={p.logo} class="logo" />}
            {p.year && <div><dt>Year</dt><dd>{p.year}</dd></div>}
            {p.platform && <div><dt>Platform</dt><dd>{p.platform}</dd></div>}
            {p.status && <div><dt>Status</dt><dd>{p.status}</dd></div>}
            {p.stack && <div><dt>Made with</dt><dd>{p.stack}</dd></div>}
          </dl>
          <div class:list={['thumb', p.imageShape ?? 'screen']}>
            {p.image && (
              <Picture
                src={p.image}
                alt={p.imageAlt ?? ''}
                formats={['webp']}
                widths={p.imageShape === 'phone' ? [320, 480, 640] : [480, 800, 1200]}
                sizes="(min-width: 960px) 26vw, 92vw"
                loading={i < 2 ? 'eager' : 'lazy'}
              />
            )}
          </div>
          {p.href && <span class="go" aria-hidden="true"><Arrow /></span>}
          {p.href && <span class="visually-hidden">{p.linkLabel}</span>}
        </Tag>
      </li>
    );
  })}
</ol>

<style>
  .index { list-style: none; border-top: 2px solid var(--rule); }
  .entry { border-bottom: 1px solid var(--hairline); }

  .row {
    position: relative;
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    column-gap: var(--gutter);
    row-gap: var(--s-6);
    padding-block: var(--s-8) var(--s-12);
    text-decoration: none;
    color: inherit;
  }
  .row:focus-visible { outline: 2px solid var(--signal); outline-offset: 6px; }

  /* Mobile: number and title, then image, then facts. */
  .no { grid-column: 1 / -1; font-size: 0.8125rem; color: var(--ink-2); }
  .head { grid-column: 1 / -1; display: grid; gap: var(--s-4); align-content: start; }
  .thumb { grid-column: 1 / -1; }
  .facts { grid-column: 1 / -1; }

  @media (min-width: 960px) {
    .row { align-items: start; row-gap: 0; }
    .no { grid-column: 1 / span 1; font-size: clamp(2rem, 1rem + 2vw, 3.5rem); line-height: 0.9; letter-spacing: -0.04em; color: var(--ink); font-family: var(--font); font-weight: 300; }
    .head { grid-column: 2 / span 5; }
    .facts { grid-column: 7 / span 2; }
    .thumb { grid-column: 9 / span 4; }
  }

  h3 {
    font-size: clamp(2rem, 1.2rem + 3vw, 4rem);
    font-weight: 650;
    letter-spacing: -0.045em;
    line-height: 0.95;
    text-wrap: balance;
  }
  .summary { color: var(--ink-2); font-size: var(--t-lead); line-height: 1.3; letter-spacing: -0.01em; max-width: 34ch; }

  .facts { display: grid; gap: var(--s-3); font-size: 0.8125rem; align-content: start; }
  .facts div { display: grid; gap: 2px; }
  .facts dt { color: var(--ink-2); font-size: 0.6875rem; letter-spacing: 0.08em; text-transform: uppercase; }
  .facts dd { line-height: 1.35; }
  .facts :global(.logo) { width: 28px; color: var(--accent); margin-bottom: var(--s-2); }
  /* At night the brand colours are too dark against the page; lift them toward the light ink. */
  :global(:root[data-theme='dark']) .facts :global(.logo) { color: color-mix(in oklab, var(--accent) 55%, var(--ink)); }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .facts :global(.logo) { color: color-mix(in oklab, var(--accent) 55%, var(--ink)); }
  }
  @media (max-width: 959px) {
    .facts { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .facts :global(.logo) { grid-column: 1 / -1; }
  }

  /* The image sits on a panel of the project's colour. Store graphics crop to the device. */
  .thumb {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--accent);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .thumb :global(picture) { display: contents; }
  .thumb :global(img) {
    display: block;
    transition: transform 320ms var(--ease-out);
  }
  .thumb.screen :global(img) { width: 86%; height: auto; box-shadow: 0 12px 28px -12px rgb(0 0 0 / 0.5); }
  /* Store graphics carry their own headline at the top; crop to the device below it. */
  .thumb.phone { align-items: flex-end; }
  .thumb.phone :global(img) { width: 54%; height: 88%; object-fit: cover; object-position: 50% 100%; }
  .idea .thumb.phone { align-items: center; }
  .idea .thumb.phone :global(img) { height: 84%; object-position: 50% 0%; }

  /* The one thing out of place. */
  .idea .thumb { transform: rotate(-2.5deg); }
  .idea .no::after {
    content: 'idea';
    display: block;
    margin-top: var(--s-2);
    font-family: var(--mono);
    font-size: 0.75rem;
    font-weight: 400;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-2);
  }
  @media (max-width: 959px) { .idea .no::after { display: inline; margin: 0 0 0 var(--s-2); } }

  .go {
    position: absolute;
    top: var(--s-8);
    right: 0;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--ink);
    color: var(--paper);
    opacity: 0;
    transform: translate(-6px, 6px) scale(0.9);
    transition: opacity 200ms ease, transform 240ms var(--ease-out);
  }
  .go :global(svg) { width: 16px; height: 16px; }

  @media (hover: hover) {
    .row:hover .thumb :global(img) { transform: translateY(-6px) scale(1.02); }
    .row:hover h3 { text-decoration: underline; text-decoration-thickness: 3px; text-underline-offset: 0.12em; text-decoration-color: var(--accent); }
    .row:hover .go { opacity: 1; transform: none; }
  }
  @media (max-width: 959px) { .go { display: none; } }
  @media (prefers-reduced-motion: reduce) { .thumb :global(img), .go { transition: none; } }
</style>
