---
import Base from '../layouts/Base.astro';
---
<Base title="Not found">
  <section class="wrap nf">
    <h1>404</h1>
    <p>This page isn’t in the head. It may have moved when the site was rebuilt.</p>
    <a class="button solid" href="/">Back to the studio</a>
  </section>
</Base>

<style>
  .nf { padding-block: var(--s-16) var(--s-32); display: grid; gap: var(--s-8); justify-items: start; }
  h1 { font-size: var(--t-display); font-weight: 700; letter-spacing: -0.055em; line-height: 0.86; }
  p { font-size: var(--t-lead); max-width: 28ch; line-height: 1.3; }
</style>
