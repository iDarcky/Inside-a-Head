---
import { render } from 'astro:content';
import { Picture, getImage } from 'astro:assets';
import { experimental_AstroContainer } from 'astro/container';
import Base from '../../layouts/Base.astro';
import Arrow from '../../components/Arrow.astro';
import AppLogo from '../../components/AppLogo.astro';
import PieceCard from '../../components/PieceCard.astro';
import ScreensCarousel from '../../components/ScreensCarousel.astro';
import { getProjects, accentStyle, type Project } from '../../lib/projects';
import { getMuseum, type Piece } from '../../lib/museum';
import { settings } from '../../lib/site';

export async function getStaticPaths() {
  const projects = await getProjects();
  const museum = await getMuseum();
  const pieceFor = (id: string) => museum.find((m) => m.id === id)!;
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: {
      project,
      piece: pieceFor(project.id),
      next: pieceFor(projects[(i + 1) % projects.length].id),
      total: museum.length,
    },
  }));
}

interface Props { project: Project; piece: Piece; next: Piece; total: number }
const { project, piece, next, total } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
const d = project.data;
const { Content } = await render(project);

// The case study is written as Markdoc with one `##` heading per section. Render it once and cut it at each heading,
// so the page can lay the sections out itself and slot the product images and the project link into the right ones.
const container = await experimental_AstroContainer.create();
const html = (await container.renderToString(Content)).replace(/^\s*<article[^>]*>|<\/article>\s*$/g, '');
const parts = html.split(/(?=<h2[\s>])/).filter((x) => x.trim());
type Section = { title: string; key: string; body: string };
const sections: Section[] = parts.map((part) => {
  const m = part.match(/^<h2[^>]*>([\s\S]*?)<\/h2>([\s\S]*)$/);
  const title = m ? m[1].replace(/<[^>]+>/g, '').trim() : '';
  return { title, key: title.toLowerCase().replace(/[’']/g, ''), body: m ? m[2] : part };
});
// The product images go in a section called "The product"; without one they follow the first section.
if (!sections.some((x) => x.key === 'the product')) {
  sections.splice(Math.min(1, sections.length), 0, { title: 'The product', key: 'the product', body: '' });
}
const slug = (t: string) => t.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');

const isPhone = d.coverShape === 'phone';
// Phones: the first three screens side by side. Browser screenshots: the cover, large.
const heroShots = isPhone ? d.gallery.slice(0, 3) : [d.gallery.find((g) => g.image.src === d.cover.src) ?? { image: d.cover, alt: `${d.title} screenshot` }];
const moreShots = isPhone ? d.gallery : d.gallery.filter((g) => g.image.src !== heroShots[0].image.src);
const og = await getImage({ src: d.cover, width: 1200, format: 'jpg' });

const facts = [
  ['Role', d.role],
  ['Year', d.year],
  ['Platform', d.platform],
  ['Status', d.status],
  ['Stack', d.stack],
];
---
<Base
  title={d.title}
  description={d.summary}
  image={og.src}
  imageAlt={piece.imageAlt || `${d.title} screenshot`}
  type="article"
  jsonLd={[{
    '@type': 'CreativeWork',
    name: d.title,
    description: d.summary,
    url: new URL(`/work/${project.id}`, Astro.site).href,
    image: new URL(og.src, Astro.site).href,
    dateCreated: d.year,
    author: { '@type': 'Person', name: settings.name },
  }]}
>
  <article style={accentStyle(project)}>
    <header class="hero">
      <div class="wrap">
        <div class="hero-top">
          <a class="back mono" href="/museum"><Arrow dir="left" /> Museum of my Mess</a>
          {piece.logo && <span class="piece"><AppLogo logo={piece.logo} class="hero-logo" /></span>}
        </div>
        <div class="title-row">
          <h1>{d.title}</h1>
          <p class="sticker mono">{d.status}</p>
        </div>
        <div class="grid hero-foot">
          <p class="summary">{d.summary}</p>
          <div class="links">
            {d.link && <a class="button on-accent" href={d.link} rel="noreferrer">{d.linkLabel ?? 'Visit'} <Arrow /></a>}
            {d.repo && <a class="button on-accent ghost" href={d.repo} rel="noreferrer">Source on GitHub <Arrow /></a>}
          </div>
        </div>
      </div>
    </header>

    <div class="wrap">
      <dl class="facts grid">
        {facts.map(([k, v]) => (
          <div><dt class="mono">{k}</dt><dd>{v}</dd></div>
        ))}
      </dl>

      {sections.map((sec) => (
        <section class="section grid" aria-labelledby={`s-${slug(sec.title)}`}>
          <h2 id={`s-${slug(sec.title)}`} class="label mono">{sec.title}</h2>
          {sec.key === 'the product' ? (
            <>
              <div class:list={['showcase', isPhone ? 'phones' : 'screen']}>
                {heroShots.map((g, i) => (
                  <Picture
                    src={g.image}
                    alt={g.alt}
                    formats={['webp']}
                    widths={isPhone ? [360, 540, 720] : [800, 1200, 1600, 2400]}
                    sizes={isPhone ? '(min-width: 960px) 22vw, 30vw' : '(min-width: 960px) 80vw, 92vw'}
                    loading={i === 0 ? 'eager' : 'lazy'}
                  />
                ))}
              </div>
              {sec.body.trim() && <div class="body" set:html={sec.body} />}
              {moreShots.length > 1 && (
                <div class="more">
                  <ScreensCarousel shots={moreShots} shape={d.coverShape} label={`${d.title} screens`} />
                </div>
              )}
            </>
          ) : (
            <div class:list={['body', { list: /^\s*<ul>/.test(sec.body) && !/<p>/.test(sec.body) }]} set:html={sec.body} />
          )}
          {sec.key === 'now' && d.link && (
            <p class="cta"><a class="button" href={d.link} rel="noreferrer">Open {d.title} <Arrow /></a></p>
          )}
        </section>
      ))}
    </div>

    <nav class="next wrap" aria-labelledby="next-title">
      <h2 id="next-title" class="next-head">
        <span>Next in the museum</span>
        <a class="mono" href="/museum">All {total} pieces</a>
      </h2>
      <PieceCard piece={next} layout="wide" kicker={`${pad(next.number)} / ${pad(total)}`} />
    </nav>
  </article>
</Base>

<style>
  .hero {
    background: var(--accent);
    color: var(--on-accent);
    padding-block: var(--s-8) var(--s-12);
  }
  .back {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    min-height: 44px;
    text-decoration: none;
  }
  .back:hover { text-decoration: underline; }
  .hero-top { display: flex; align-items: center; justify-content: space-between; gap: var(--s-4); }
  .piece { display: flex; align-items: center; gap: var(--s-3); letter-spacing: 0.06em; }
  .piece :global(.hero-logo) { width: 28px; color: var(--on-accent); }
  h1 {
    margin-top: var(--s-12);
    font-size: var(--t-display);
    font-weight: 700;
    letter-spacing: -0.055em;
    line-height: 0.86;
    margin-left: -0.04em;
    overflow-wrap: anywhere;
  }
  .title-row { position: relative; display: flex; flex-wrap: wrap; align-items: flex-start; gap: var(--s-6) var(--s-8); margin-top: var(--s-12); }
  .title-row h1 { margin-top: 0; }
  /* Status as a quiet label beside the title. */
  .sticker {
    align-self: center;
    white-space: nowrap;
    padding: var(--s-1) var(--s-2);
    border: 1px solid currentColor;
    line-height: 1.3;
  }
  .hero-foot { margin-top: var(--s-12); row-gap: var(--s-6); align-items: end; }
  .summary {
    grid-column: 1 / -1;
    font-size: var(--t-lead);
    line-height: 1.3;
    letter-spacing: -0.015em;
    max-width: 30ch;
  }
  .links { grid-column: 1 / -1; display: flex; flex-wrap: wrap; gap: var(--s-3); }
  @media (min-width: 720px) {
    .summary { grid-column: 1 / span 7; }
    .links { grid-column: 9 / -1; justify-content: flex-end; }
  }
  .button.on-accent { border-color: var(--on-accent); color: var(--accent); background: var(--on-accent); }
  .button.on-accent:hover { background: transparent; color: var(--on-accent); }
  .button.on-accent.ghost { background: transparent; color: var(--on-accent); }
  .button.on-accent.ghost:hover { background: var(--on-accent); color: var(--accent); }
  .hero :focus-visible { outline-color: var(--on-accent); }

  .facts {
    padding-block: var(--s-6);
    row-gap: var(--s-4);
    border-bottom: 1px solid var(--hairline);
  }
  .facts div { grid-column: span 2; }
  .facts div:last-child { grid-column: 1 / -1; }
  .facts dt { color: var(--ink-2); margin-bottom: var(--s-1); }
  .facts dd { font-size: var(--t-small); }
  @media (min-width: 720px) {
    .facts div { grid-column: span 2; }
    .facts div:last-child { grid-column: span 4; }
  }

  /* Case study: one section per heading, each under a hairline. The label hangs in the left columns and the text
     runs in a 7-column measure; the product images span the full width. */
  .section { padding-block: var(--s-8) var(--s-16); border-top: 1px solid var(--hairline); row-gap: var(--s-6); }
  .section:first-of-type { margin-top: var(--s-12); border-top-color: var(--ink); }
  .section > * { grid-column: 1 / -1; }
  .label {
    font-size: var(--t-meta);
    font-weight: 400;
    letter-spacing: 0.06em;
    color: var(--ink-2);
  }
  .body { font-size: var(--t-body); }
  .body :global(p), .body :global(ul), .body :global(ol) { max-width: 62ch; }
  .body :global(p + p), .body :global(p + ul), .body :global(ul + p) { margin-top: var(--s-4); }
  .body :global(ul), .body :global(ol) { padding-left: 1.2em; }
  .body :global(li + li) { margin-top: var(--s-2); }
  .body :global(strong) { font-weight: 600; }
  .body :global(code) { font-family: var(--mono); font-size: 0.9em; }
  .body :global(a) { text-decoration-color: var(--accent); text-decoration-thickness: 2px; }
  /* The first paragraph of every section reads a step larger. */
  .body > :global(p:first-child) { font-size: var(--t-lead); line-height: 1.3; letter-spacing: -0.015em; max-width: 34ch; }
  .body > :global(p:first-child:has(strong:first-child)) { font-size: inherit; line-height: inherit; letter-spacing: inherit; max-width: 62ch; }
  /* A bare list (like "What I did") as ruled rows. */
  .body.list :global(ul) { list-style: none; padding: 0; max-width: none; border-top: 1px solid var(--ink); }
  .body.list :global(li) { margin: 0; padding-block: var(--s-3); border-bottom: 1px solid var(--hairline); font-size: var(--t-lead); letter-spacing: -0.015em; }
  .cta { margin-top: var(--s-2); }

  /* The product: one large panel in the project colour. */
  .showcase { background: var(--accent); display: grid; gap: clamp(12px, 3vw, 48px); padding: clamp(20px, 6vw, 112px); }
  .showcase :global(img) { display: block; width: 100%; height: auto; }
  .showcase.phones { grid-template-columns: repeat(3, minmax(0, 1fr)); align-items: start; }
  .showcase.screen :global(img) { box-shadow: 0 24px 48px -20px rgb(0 0 0 / 0.55); }
  .more { margin-top: var(--s-8); }

  @media (min-width: 960px) {
    .label { grid-column: 1 / span 4; padding-top: 0.45em; }
    .section > .body, .section > .cta { grid-column: 5 / span 7; }
    .section > .showcase, .section > .more { grid-column: 1 / -1; }
    .section > .showcase + .body { grid-column: 5 / span 7; }
  }

  /* The next piece, as the same card the homepage carousel uses. */
  .next { padding-block: 0 var(--s-24); }
  .next-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-4);
    font-size: var(--t-h3);
    letter-spacing: -0.03em;
    border-top: 2px solid var(--rule);
    padding-top: var(--s-3);
    margin-bottom: var(--s-8);
  }
  .next-head a { font-size: var(--t-meta); font-weight: 400; color: var(--ink-2); text-decoration: none; }
  .next-head a:hover { color: var(--ink); text-decoration: underline; }
</style>
