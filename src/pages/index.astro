---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import SessionCard from '../components/SessionCard.astro';
import Bookshelf, { type Book, type Emblem } from '../components/Bookshelf.astro';
import { getProjects } from '../lib/projects';
import { settings, formatDate, sessionNumbers } from '../lib/site';

const projects = await getProjects();
const logbook = (await getCollection('logbook')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const latest = logbook.slice(0, 4);
const sessions = sessionNumbers(logbook);

const stateLabel = { idea: 'Idea', paused: 'Paused', abandoned: 'Abandoned', became: 'Became something' } as const;
const ideas = await getCollection('mess');

// Each book's emblem, drawn from what the project is.
const emblemFor: Record<string, Emblem> = {
  'the-retro-circuit': 'pixels',
  'setlists-md': 'staff',
  meridian: 'sun',
  ridely: 'road',
  'redline-running': 'track',
};

// The Museum of my Mess: every project is a book in its own colour, then the ideas still waiting on the shelf.
const books: Book[] = [
  ...projects.map((p) => ({
    id: p.id,
    title: p.data.title,
    year: p.data.year,
    color: p.data.accent,
    meta: `${p.data.platform} · ${p.data.year} · ${p.data.status}`,
    text: p.data.summary,
    href: `/work/${p.id}`,
    linkLabel: 'Read the case study',
    emblem: emblemFor[p.id],
  })),
  ...ideas.map((m) => ({
    id: m.id,
    title: m.data.title,
    year: m.data.year,
    color: m.data.color ?? '#55544f',
    meta: [stateLabel[m.data.state], m.data.year].filter(Boolean).join(' · '),
    text: m.data.note,
    href: m.data.link ?? undefined,
    linkLabel: m.data.link ? 'Visit' : undefined,
    emblem: emblemFor[m.id],
    lean: m.data.state === 'idea',
  })),
];
---
<Base>
  <section class="masthead wrap" aria-labelledby="masthead-title">
    <h1 id="masthead-title">inside a head</h1>
    <div class="grid intro">
      <p class="lead">{settings.intro}</p>
      <dl class="facts">
        <div><dt>Studio of</dt><dd>{settings.name}</dd></div>
        <div><dt>By day</dt><dd>{settings.role}</dd></div>
        <div><dt>Based in</dt><dd>{settings.location}</dd></div>
      </dl>
      <div class="actions">
        <a class="button solid" href="/about">About the studio</a>
        <a class="button" href="/resume">Resume</a>
      </div>
    </div>
  </section>

  <section class="section wrap" id="museum" aria-labelledby="museum-title">
    <SessionCard number={1} title="Museum of my Mess" id="museum-title">{projects.length} things I’ve built, {ideas.length} still waiting</SessionCard>
    <p class="museum-lead">
      Every book on this shelf is an idea. Some became products, one is still waiting for its turn. Pick a book to
      read about it.{' '}<a href="/about">Why this studio exists</a>.
    </p>
    <Bookshelf books={books} />
  </section>

  <section class="section wrap" id="logbook" aria-labelledby="logbook-title">
    <SessionCard number={2} title="Logbook" id="logbook-title"><a href="/logbook">All entries</a></SessionCard>
    {latest.length === 0 ? (
      <p class="empty">The first entry is on its way.</p>
    ) : (
      <ol class="rows">
        {latest.map((e) => (
          <li>
            <a class="row grid" href={`/logbook/${e.id}`}>
              <span class="mono when">Session {sessions.get(e.id)} · <time datetime={e.data.date.toISOString()}>{formatDate(e.data.date)}</time></span>
              <span class="row-title">{e.data.title}</span>
              {e.data.summary && <span class="row-note">{e.data.summary}</span>}
              <Arrow dir="right" />
            </a>
          </li>
        ))}
      </ol>
    )}
  </section>

</Base>

<style>
  .masthead {
    padding-block: var(--s-12) var(--s-16);
  }
  h1 {
    /* Set to fill the grid: the wordmark is the poster. */
    font-size: clamp(3.5rem, 21vw, 17rem);
    font-weight: 700;
    letter-spacing: -0.055em;
    line-height: 0.86;
    margin-left: -0.03em; /* optical: align the i's stem with the grid edge */
  }
  .intro {
    margin-top: var(--s-12);
    row-gap: var(--s-8);
    align-items: end;
  }
  .lead {
    grid-column: 1 / -1;
    font-size: var(--t-lead);
    line-height: 1.3;
    letter-spacing: -0.015em;
    max-width: 34ch;
  }
  .lead strong { font-weight: 600; }
  .facts {
    grid-column: 1 / -1;
    display: grid;
    gap: var(--s-2);
    font-size: var(--t-small);
    border-top: 1px solid var(--hairline);
    padding-top: var(--s-3);
  }
  .facts div { display: grid; grid-template-columns: 7rem 1fr; gap: var(--s-4); }
  .facts dt { color: var(--ink-2); }
  .actions { grid-column: 1 / -1; display: flex; flex-wrap: wrap; gap: var(--s-3); }
  @media (min-width: 720px) {
    h1 { font-size: min(15.4vw, 16.5rem); }
    .lead { grid-column: 1 / span 7; }
    .facts { grid-column: 9 / -1; }
    .actions { grid-column: 9 / -1; }
  }


  .rows { list-style: none; }
  .rows li { border-top: 1px solid var(--hairline); }
  .rows li:last-child { border-bottom: 1px solid var(--hairline); }
  .row {
    padding-block: var(--s-4);
    row-gap: var(--s-1);
    align-items: baseline;
    text-decoration: none;
    min-height: 56px;
  }
  .row > * { grid-column: 1 / -1; }
  .row > :global(svg) { display: none; }
  .row-title { font-size: var(--t-h3); font-weight: 600; letter-spacing: -0.03em; line-height: 1.15; }
  .row-note { color: var(--ink-2); max-width: 60ch; }
  .row .when { color: var(--ink-2); }
  a.row { transition: background-color 160ms ease; }
  @media (hover: hover) {
    a.row:hover .row-title { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 0.15em; }
  }
  @media (min-width: 720px) {
    .row > :nth-child(1) { grid-column: 1 / span 2; }
    .row > :nth-child(2) { grid-column: 3 / span 4; }
    .row > :nth-child(3) { grid-column: 7 / span 5; }
    .row > :global(svg) { display: block; grid-column: 12; justify-self: end; align-self: center; }
  }

  .empty { color: var(--ink-2); }

  .museum-lead {
    font-size: var(--t-lead);
    line-height: 1.3;
    letter-spacing: -0.015em;
    max-width: 38ch;
    margin-bottom: var(--s-12);
  }
</style>
