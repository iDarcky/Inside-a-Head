---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Poster from '../components/Poster.astro';
import Arrow from '../components/Arrow.astro';
import { getProjects } from '../lib/projects';
import { settings, formatDate } from '../lib/site';

const projects = await getProjects();
const logbook = (await getCollection('logbook')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const latest = logbook.slice(0, 4);

const stateOrder = { idea: 0, paused: 1, abandoned: 2, became: 3 } as const;
const stateLabel = { idea: 'Idea', paused: 'Paused', abandoned: 'Abandoned', became: 'Became something' } as const;
const mess = (await getCollection('mess')).sort((a, b) => stateOrder[a.data.state] - stateOrder[b.data.state]);

// Poster wall rhythm: wide/narrow, then narrow/wide. Odd counts end full width.
const spans = projects.map((_, i) => {
  if (i === projects.length - 1 && projects.length % 2 === 1) return 12;
  return (Math.floor(i / 2) % 2 === 0) === (i % 2 === 0) ? 7 : 5;
}) as (5 | 7 | 12)[];
---
<Base>
  <section class="masthead wrap" aria-labelledby="masthead-title">
    <h1 id="masthead-title">inside a head</h1>
    <div class="grid intro">
      <p class="lead">{settings.intro}</p>
      <dl class="facts">
        <div><dt>Studio of</dt><dd>{settings.name}</dd></div>
        <div><dt>By day</dt><dd>{settings.role}</dd></div>
        <div><dt>Based in</dt><dd>{settings.location}</dd></div>
      </dl>
      <div class="actions">
        <a class="button solid" href="/about">About the studio</a>
        <a class="button" href="/resume">Resume</a>
      </div>
    </div>
  </section>

  <section class="section wrap" id="work" aria-labelledby="work-title">
    <div class="section-head grid">
      <h2 id="work-title">Work</h2>
      <p class="mono">{projects.length} things I’ve built</p>
    </div>
    <div class="grid wall">
      {projects.map((p, i) => <Poster project={p} span={spans[i]} eager={i < 2} />)}
    </div>
  </section>

  <section class="section wrap" id="logbook" aria-labelledby="logbook-title">
    <div class="section-head grid">
      <h2 id="logbook-title">Logbook</h2>
      <p class="mono"><a href="/logbook">All entries</a></p>
    </div>
    {latest.length === 0 ? (
      <p class="empty">The first entry is on its way.</p>
    ) : (
      <ol class="rows">
        {latest.map((e) => (
          <li>
            <a class="row grid" href={`/logbook/${e.id}`}>
              <time class="mono" datetime={e.data.date.toISOString()}>{formatDate(e.data.date)}</time>
              <span class="row-title">{e.data.title}</span>
              {e.data.summary && <span class="row-note">{e.data.summary}</span>}
              <Arrow dir="right" />
            </a>
          </li>
        ))}
      </ol>
    )}
  </section>

  <section class="section wrap" id="museum" aria-labelledby="museum-title">
    <div class="section-head grid">
      <h2 id="museum-title">Museum of my Mess</h2>
      <p class="mono">Ideas, pauses and the things they turned into</p>
    </div>
    <p class="museum-lead">
      Ideas are messy. Not all of them become products, and the ones that don’t still belong
      somewhere.{' '}<a href="/about">Why this studio exists</a>.
    </p>
    <ul class="rows">
      {mess.map((m) => {
        const inner = (
          <>
            <span class="mono state" data-state={m.data.state}>{stateLabel[m.data.state]}</span>
            <span class="row-title">{m.data.title}</span>
            <span class="row-note">{m.data.note}</span>
            {m.data.link ? <Arrow /> : <span aria-hidden="true" />}
          </>
        );
        return (
          <li>
            {m.data.link ? (
              <a class="row grid" href={m.data.link} rel="noreferrer">{inner}</a>
            ) : (
              <div class="row grid">{inner}</div>
            )}
          </li>
        );
      })}
    </ul>
  </section>
</Base>

<style>
  .masthead {
    padding-block: var(--s-12) var(--s-16);
  }
  h1 {
    /* Set to fill the grid: the wordmark is the poster. */
    font-size: clamp(3.5rem, 21vw, 17rem);
    font-weight: 700;
    letter-spacing: -0.055em;
    line-height: 0.86;
    margin-left: -0.03em; /* optical: align the i's stem with the grid edge */
  }
  .intro {
    margin-top: var(--s-12);
    row-gap: var(--s-8);
    align-items: end;
  }
  .lead {
    grid-column: 1 / -1;
    font-size: var(--t-lead);
    line-height: 1.3;
    letter-spacing: -0.015em;
    max-width: 34ch;
  }
  .lead strong { font-weight: 600; }
  .facts {
    grid-column: 1 / -1;
    display: grid;
    gap: var(--s-2);
    font-size: var(--t-small);
    border-top: 1px solid var(--hairline);
    padding-top: var(--s-3);
  }
  .facts div { display: grid; grid-template-columns: 7rem 1fr; gap: var(--s-4); }
  .facts dt { color: var(--ink-2); }
  .actions { grid-column: 1 / -1; display: flex; flex-wrap: wrap; gap: var(--s-3); }
  @media (min-width: 720px) {
    h1 { font-size: min(15.4vw, 16.5rem); }
    .lead { grid-column: 1 / span 7; }
    .facts { grid-column: 9 / -1; }
    .actions { grid-column: 9 / -1; }
  }

  .wall { row-gap: var(--gutter); }

  .rows { list-style: none; }
  .rows li { border-top: 1px solid var(--hairline); }
  .rows li:last-child { border-bottom: 1px solid var(--hairline); }
  .row {
    padding-block: var(--s-4);
    row-gap: var(--s-1);
    align-items: baseline;
    text-decoration: none;
    min-height: 56px;
  }
  .row > * { grid-column: 1 / -1; }
  .row > :global(svg) { display: none; }
  .row-title { font-size: var(--t-h3); font-weight: 600; letter-spacing: -0.03em; line-height: 1.15; }
  .row-note { color: var(--ink-2); max-width: 60ch; }
  .row time, .state { color: var(--ink-2); }
  a.row { transition: background-color 160ms ease; }
  @media (hover: hover) {
    a.row:hover .row-title { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 0.15em; }
  }
  @media (min-width: 720px) {
    .row > :nth-child(1) { grid-column: 1 / span 2; }
    .row > :nth-child(2) { grid-column: 3 / span 4; }
    .row > :nth-child(3) { grid-column: 7 / span 5; }
    .row > :global(svg) { display: block; grid-column: 12; justify-self: end; align-self: center; }
  }
  .state[data-state='idea']::before,
  .state[data-state='paused']::before,
  .state[data-state='abandoned']::before,
  .state[data-state='became']::before {
    content: '';
    display: inline-block;
    width: 0.6em;
    height: 0.6em;
    margin-right: 0.5em;
    border: 1.5px solid currentColor;
  }
  .state[data-state='became']::before { background: currentColor; }
  .state[data-state='idea']::before { border-radius: 50%; }

  .empty { color: var(--ink-2); }

  .museum-lead {
    font-size: var(--t-lead);
    line-height: 1.3;
    letter-spacing: -0.015em;
    max-width: 38ch;
    margin-bottom: var(--s-12);
  }
</style>
