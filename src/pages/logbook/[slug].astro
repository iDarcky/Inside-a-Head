---
export const prerender = false;
import MagazineLayout from '../../layouts/MagazineLayout.astro';
import PortableText from '../../components/PortableText.astro';
import { sanityClient, urlFor } from '../../utils/sanity';
import { SITE_URL, SITE_AUTHOR, portableTextToPlain, excerpt } from '../../utils/site';

const { slug } = Astro.params;
let entry = null;

try {
  entry = await sanityClient.fetch(`*[_type == "logbookEntry" && slug.current == $slug][0]`, { slug });
} catch (error) {
  console.error("Failed to fetch logbook entry:", error);
}

if (!entry) {
  // An empty 404 response makes Astro render src/pages/404.astro with a real 404 status (no redirect)
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

// Reading time heuristic
const words = entry.body
  ? entry.body
      .filter((block: any) => block._type === 'block' && block.children)
      .map((block: any) => block.children.map((child: any) => child.text).join(' '))
      .join(' ')
      .split(/\s+/).length
  : 0;
const readingTime = Math.ceil(words / 200);

const plainBody = portableTextToPlain(entry.body);
const description = plainBody ? excerpt(plainBody) : `A logbook entry from Inside a Head: ${entry.title}`;
const ogImage = entry.heroImage ? urlFor(entry.heroImage).width(1200).height(630).fit('crop').auto('format').url() : null;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: entry.title,
  description,
  url: `${SITE_URL}/logbook/${entry.slug.current}`,
  author: { '@type': 'Person', name: SITE_AUTHOR },
  ...(entry.publishedAt ? { datePublished: entry.publishedAt } : {}),
  ...(ogImage ? { image: ogImage } : {}),
};
---

<MagazineLayout title={entry.title} description={description} image={ogImage} type="article" publishedAt={entry.publishedAt} jsonLd={jsonLd}>
  {entry.heroImage && (
    <div class="project-hero-wrapper">
      <img
        src={urlFor(entry.heroImage).width(1600).auto('format').url()}
        srcset={[800, 1200, 1600, 2400].map((w) => `${urlFor(entry.heroImage).width(w).auto('format').url()} ${w}w`).join(', ')}
        sizes="100vw"
        alt={entry.title}
        class="project-hero-img"
        fetchpriority="high"
      />
    </div>
  )}

  <article class="article-layout">
    <header class="article-header">
      <span class="manifesto-kicker" style="margin-bottom: 12px;">LOGBOOK ENTRY</span>
      <h1 class="article-title">{entry.title}</h1>
      <div class="article-meta-grid">
        <div class="meta-item">
          <span class="meta-label">PUBLISHED</span>
          <span class="meta-value">{entry.publishedAt ? new Date(entry.publishedAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : 'N/A'}</span>
        </div>
        <div class="meta-item">
          <span class="meta-label">READING TIME</span>
          <span class="meta-value">{readingTime} MIN READ</span>
        </div>
      </div>
    </header>

    <section class="article-body">
      {entry.body ? <PortableText portableText={entry.body} /> : <p>No content available.</p>}
    </section>

    <footer class="magazine-footer-nav" style="justify-content: flex-end;">
      <a href="/#logbook" class="footer-nav-link" data-hover style="text-align: right;">
        <span class="nav-label">RETURN TO</span>
        Logbook
      </a>
    </footer>
  </article>
</MagazineLayout>

