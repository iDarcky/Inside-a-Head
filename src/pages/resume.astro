---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import { settings } from '../lib/site';

const experience = [
  {
    dates: '05/2021 – 01/2025',
    title: 'Junior Technical Product Manager',
    org: 'ATOSS Software AG',
    meta: 'Timișoara · Full-time',
    points: [
      'Owned end-to-end product lifecycle for enterprise workforce management features across 5+ major releases.',
      'Partnered with engineering and UX to define specs and acceptance criteria, reducing story-cycle time.',
      'Built and maintained roadmaps in Jira/Confluence, aligning engineering, sales, and customer success priorities.',
      'Ran user interviews and requirement workshops with enterprise clients, translating insights into actionable epics.',
    ],
  },
  {
    dates: '01/2016 – 01/2018',
    title: 'Assistant Manager',
    org: 'Scripture Union Romania',
    meta: 'Timișoara · Part-time',
    points: [
      'Led cross-functional volunteer teams of 20+ people across social and educational programs for 100+ youth.',
      'Organized 3 international youth camps per year, owning full logistics and stakeholder communication.',
    ],
  },
];

const projects = [
  {
    dates: '2024',
    title: 'The Retro Circuit',
    org: 'Founder & Sole Developer',
    link: { href: 'https://theretrocircuit.com/', label: 'theretrocircuit.com' },
    points: [
      'Identified market fragmentation in retro gaming hardware: consumers lacked a reliable way to compare complex device variants. Designed and shipped a specialized comparison engine from zero to MVP in 3 months.',
      'Leveraged Google AI Studio as an engineering counterpart — writing precise specs, defining architecture constraints, and managing a CI/CD pipeline (Next.js 16, Supabase/PostgreSQL, Vercel) without writing code natively.',
      'Architected a relational data schema (Manufacturers → Consoles → Variants) to eliminate ‘signal noise’ — enabling SKU-level comparisons rather than generic product aggregations.',
      'Built a restricted Admin Command Center with RBAC and validation rules, enabling non-technical content management and scaling the product catalog without database intervention.',
    ],
    tags: ['Next.js', 'Supabase', 'SQL', 'Resend', 'Jira'],
  },
];

const education = [
  { dates: '2019 – 2021', title: 'Master of Business Management', org: 'Universitatea de Vest Timișoara' },
  { dates: '2016 – 2019', title: 'Bachelor of Business Management', org: 'Universitatea de Vest Timișoara' },
];

const skills = [
  ['Product', 'Roadmapping, Product Discovery, User Story Writing, OKRs, A/B Testing, Agile/Scrum, Zero-to-One Delivery'],
  ['Technical', 'AI-Assisted Development, Relational DB Modeling, Architecture Strategy, Next.js / React, Supabase, Vercel'],
  ['Languages', 'Romanian (Native), English (Fluent), German (Basic)'],
];

const certifications = ['Product Strategy (PSC)', 'Product Discovery', 'Product Experimentation', 'Product-Led Growth'];

const volunteering = [
  { org: 'BBPT', role: 'Social Media Lead', text: 'Led social media strategy (Facebook/Instagram) and implemented software for media production and lyric projection.' },
  { org: 'Scripture Union', role: 'Team Leader & Coordinator', text: 'Recruited and led 20+ volunteers; coordinated international camps, youth programs, and NGO outreach initiatives.' },
];
---
<Base title="Resume" description={`Resume of ${settings.name}, product manager with enterprise SaaS experience.`}>
  <article class="wrap cv">
    <header class="top grid">
      <h1>{settings.name}</h1>
      <p class="role">Product Manager</p>
      <p class="summary">
        Product Manager with 4+ years of enterprise SaaS experience. At ATOSS Software AG I drove product discovery,
        roadmapping, and cross-functional delivery for workforce management solutions. Also shipped a full-stack
        personal project (The Retro Circuit) from zero to MVP in 3 months as sole PM.
      </p>
      <ul class="contact mono">
        <li><a href={`mailto:${settings.email}`}>{settings.email}</a></li>
        <li><a href={settings.linkedin} rel="me noreferrer">linkedin.com/in/danielnmaghis</a></li>
        <li>Timișoara</li>
        <li><a href="tel:+40735646723">0735 646 723</a></li>
      </ul>
      <div class="actions no-print">
        <button class="button solid" type="button" data-print>Save as PDF</button>
        <a class="button" href={settings.linkedin} rel="me noreferrer">LinkedIn <Arrow /></a>
      </div>
    </header>

    <section class="block grid" aria-labelledby="cv-experience">
      <h2 id="cv-experience">Experience</h2>
      <ol class="items">
        {experience.map((e) => (
          <li class="item">
            <p class="dates mono">{e.dates}</p>
            <div>
              <h3>{e.title}</h3>
              <p class="org">{e.org} <span>· {e.meta}</span></p>
              <ul class="points">{e.points.map((p) => <li>{p}</li>)}</ul>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="block grid" aria-labelledby="cv-projects">
      <h2 id="cv-projects">Projects</h2>
      <ol class="items">
        {projects.map((e) => (
          <li class="item">
            <p class="dates mono">{e.dates}</p>
            <div>
              <h3>{e.title}</h3>
              <p class="org">{e.org} <span>· <a href={e.link.href} rel="noreferrer">{e.link.label}</a></span></p>
              <ul class="points">{e.points.map((p) => <li>{p}</li>)}</ul>
              <p class="tags mono">{e.tags.join(' · ')}</p>
            </div>
          </li>
        ))}
        <li class="item">
          <p class="dates mono">2026</p>
          <div>
            <h3>Setlists.md, Meridian, Ridely</h3>
            <p class="org">Personal projects <span>· <a href="/#work">Case studies</a></span></p>
          </div>
        </li>
      </ol>
    </section>

    <section class="block grid" aria-labelledby="cv-education">
      <h2 id="cv-education">Education</h2>
      <ol class="items">
        {education.map((e) => (
          <li class="item">
            <p class="dates mono">{e.dates}</p>
            <div><h3>{e.title}</h3><p class="org">{e.org}</p></div>
          </li>
        ))}
      </ol>
    </section>

    <section class="block grid" aria-labelledby="cv-skills">
      <h2 id="cv-skills">Skills</h2>
      <dl class="items">
        {skills.map(([k, v]) => (
          <div class="item"><dt class="dates mono">{k}</dt><dd>{v}</dd></div>
        ))}
        <div class="item">
          <dt class="dates mono">Certifications</dt>
          <dd><ul class="plain">{certifications.map((c) => <li>{c} <span class="muted">· Product School</span></li>)}</ul></dd>
        </div>
      </dl>
    </section>

    <section class="block grid" aria-labelledby="cv-volunteering">
      <h2 id="cv-volunteering">Volunteering &amp; leadership</h2>
      <ol class="items">
        {volunteering.map((v) => (
          <li class="item">
            <p class="dates mono">{v.org}</p>
            <div><h3>{v.role}</h3><p class="muted">{v.text}</p></div>
          </li>
        ))}
      </ol>
    </section>
  </article>
</Base>

<script>
  document.querySelector('[data-print]')?.addEventListener('click', () => window.print());
</script>

<style>
  .cv { padding-bottom: var(--s-24); }
  .top { padding-block: var(--s-12) var(--s-16); row-gap: var(--s-6); align-items: end; }
  h1 { grid-column: 1 / -1; font-size: var(--t-h2); }
  .role { grid-column: 1 / -1; font-size: var(--t-lead); color: var(--ink-2); margin-top: calc(-1 * var(--s-3)); }
  .summary { grid-column: 1 / -1; font-size: var(--t-lead); line-height: 1.35; letter-spacing: -0.01em; max-width: 46ch; }
  .contact { grid-column: 1 / -1; list-style: none; display: grid; gap: var(--s-1); color: var(--ink-2); }
  .contact a { color: var(--ink); text-decoration: none; }
  .contact a:hover { text-decoration: underline; }
  .actions { grid-column: 1 / -1; display: flex; flex-wrap: wrap; gap: var(--s-3); }
  @media (min-width: 720px) {
    .summary { grid-column: 1 / span 8; }
    .contact { grid-column: 9 / -1; }
    .actions { grid-column: 9 / -1; }
  }

  .block { border-top: 2px solid var(--rule); padding-block: var(--s-3) var(--s-12); row-gap: var(--s-6); }
  .block h2 { grid-column: 1 / -1; font-size: var(--t-h3); letter-spacing: -0.03em; line-height: 1.1; }
  .items { grid-column: 1 / -1; list-style: none; display: grid; gap: var(--s-8); margin: 0; }
  .item { display: grid; gap: var(--s-2); }
  @media (min-width: 720px) {
    .block h2 { grid-column: 1 / span 3; }
    .items { grid-column: 4 / -1; }
    .item { grid-template-columns: 10rem 1fr; gap: var(--gutter); }
  }
  .dates { color: var(--ink-2); padding-top: 0.3em; }
  h3 { font-size: 1.25rem; letter-spacing: -0.02em; line-height: 1.25; }
  .org { margin-top: var(--s-1); }
  .org span, .muted { color: var(--ink-2); }
  .points { margin-top: var(--s-3); padding-left: 1.1em; max-width: 72ch; }
  .points li + li { margin-top: var(--s-2); }
  .tags { margin-top: var(--s-3); color: var(--ink-2); }
  .plain { list-style: none; display: grid; gap: var(--s-1); }

  @media print {
    @page { margin: 14mm; }
    .cv { padding: 0; }
    .top { padding-block: 0 8mm; }
    .block { break-inside: avoid; padding-bottom: 6mm; }
    .item { grid-template-columns: 34mm 1fr !important; }
    .block h2 { grid-column: 1 / span 3 !important; }
    .items { grid-column: 4 / -1 !important; }
    .grid { grid-template-columns: repeat(12, 1fr) !important; }
    a { text-decoration: none; color: inherit; }
  }
</style>
