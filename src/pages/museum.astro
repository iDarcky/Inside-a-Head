---
// The whole Museum of my Mess on one page, as a bento grid, so the museum has its own address.
import Base from '../layouts/Base.astro';
import PieceCard from '../components/PieceCard.astro';
import { getMuseum } from '../lib/museum';

const pieces = await getMuseum();
const built = pieces.filter((p) => p.kind === 'project').length;
const waiting = pieces.length - built;
---
<Base title="Museum of my Mess" description="Every piece in the studio: the things I’ve built and the ideas still waiting their turn.">
  <section class="section wrap">
    <div class="head grid">
      <h1>Museum of my Mess</h1>
      <p class="intro">Every piece in here started as an idea. Some became products, one is still waiting for its turn.</p>
      <p class="count mono">{built} things I’ve built, {waiting} still waiting</p>
    </div>
    <ol class="pieces grid" role="list">
      {pieces.map((p, i) => (
        <li><PieceCard piece={p} eager={i < 2} /></li>
      ))}
    </ol>
  </section>
</Base>

<style>
  .head { row-gap: var(--s-4); margin-bottom: var(--s-16); align-items: end; }
  h1 { grid-column: 1 / -1; font-size: var(--t-display); font-weight: 700; letter-spacing: -0.055em; line-height: 0.9; }
  .intro { grid-column: 1 / -1; font-size: var(--t-lead); line-height: 1.3; color: var(--ink-2); max-width: 34ch; }
  .count { grid-column: 1 / -1; color: var(--ink-2); }
  /* A bento on the 12-column grid: a large first tile beside a narrower one, then a row of three.
     Tiles in a row share one image height, so their tops, images and text all line up. */
  .pieces { list-style: none; row-gap: var(--s-16); }
  .pieces > li { grid-column: 1 / -1; }
  @media (min-width: 720px) {
    .intro { grid-column: 1 / span 7; }
    .count { grid-column: 9 / -1; text-align: right; }
    .pieces > li { grid-column: span 6; }
    .pieces > li :global(.thumb) { aspect-ratio: auto; height: min(34vw, 340px); }
  }
  @media (min-width: 1100px) {
    .pieces > li { grid-column: span 4; }
    .pieces > li:nth-child(5n + 1) { grid-column: span 8; }
    .pieces > li:nth-child(-n + 2) :global(.thumb),
    .pieces > li:nth-child(5n + 1) :global(.thumb),
    .pieces > li:nth-child(5n + 2) :global(.thumb) { height: min(36vw, 520px); }
    .pieces > li :global(.thumb) { height: min(24vw, 360px); }
  }
</style>
